# Copy to .env for local development and fill in your Supabase values.
# On Render, set these in the service's Environment tab instead.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Supabase service_role key (Settings -> API -> Project API keys -> service_role).
# Keep this secret. Server-side only.
SUPABASE_SERVICE_KEY=

# Table name (matches supabase_schema.sql).
SUPABASE_TABLE=users

# Origins allowed to call this API from a browser.
CORS_ALLOW_ORIGINS=https://synnovatify.com,https://www.synnovatify.com
